NEON_PROJECT_ID=lively-mode-43176304
PARENT_BRANCH_ID=br-wandering-glade-az8csblo
DELETE_BRANCH=true

# Security Secrets & Third-Party Keys
JWT_SECRET=dev_jwt_secret_key_change_me_in_production_12345
