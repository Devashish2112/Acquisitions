# Node.js Server Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# ==============================================================================
# 1. DEVELOPMENT CONFIGURATION (Used with Neon Local proxy via docker-compose.dev.yml)
# ==============================================================================
DATABASE_URL=postgres://neon:npg@neon-local:5432/neondb?sslmode=require
NEON_LOCAL_HOST=neon-local

# Neon Cloud API credentials required by neon-local proxy to create ephemeral dev branches
NEON_API_KEY=your_neon_api_key_here
NEON_PROJECT_ID=your_neon_project_id_here
PARENT_BRANCH_ID=main
DELETE_BRANCH=true

# ==============================================================================
# 2. PRODUCTION CONFIGURATION (Direct connection string to Neon Cloud DB)
# ==============================================================================
# DATABASE_URL=postgresql://<user>:<password>@<project>.pooler.<region>.neon.tech/<dbname>?sslmode=require&channel_binding=require

# App Security Secrets
JWT_SECRET=your_jwt_secret_here
ARCJET_ENV=development
ARCJET_KEY=your_arcjet_key_here